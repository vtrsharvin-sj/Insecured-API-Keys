# Insecured API Keys UI — environment configuration
# Copy to .env.development for local dev, or set these as build args in Docker.

# API base URL — in Docker this is set to /apiproxy at build time (nginx proxy)
# For local development point it at the running WebAPI
NEXT_PUBLIC_API_URL=http://localhost:7227

# Google Analytics GA4 (optional — leave blank to disable tracking entirely)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.0
