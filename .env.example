# Insecured API Keys — deployment configuration
# Copy to .env before running:  cp .env.example .env
# Then edit every value marked CHANGE_ME.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password   # REQUIRED — never leave as default

# ── Web API ───────────────────────────────────────────────────────────────────
# Host port for direct API access (the API always listens on 8080 in-container).
API_PORT=8081

# ── UI (nginx) ────────────────────────────────────────────────────────────────
# Port-forward THIS one to your public URL.
UI_PORT=8080

# Production / Development  (enables Swagger at /scalar/v1 in Development)
ASPNETCORE_ENVIRONMENT=Production

# ── Public domain ─────────────────────────────────────────────────────────────
# The domain visitors use to reach your site (no protocol, no trailing slash).
# Used for CORS and referrer checks.  Example:  insecuredapikeys.com
PRODUCTION_DOMAIN=

# Extra referrer hostnames the API will accept (comma-separated).
# Not needed when everything goes through the nginx proxy on the same origin.
# Example:  insecuredapikeys.com,www.insecuredapikeys.com
ALLOWED_REFERRERS=

# ── TLS ───────────────────────────────────────────────────────────────────────
# Set to 1 only if you terminate TLS yourself (e.g. Cloudflare, nginx upstream)
# and want plain HTTP redirected to HTTPS inside the container.
#FORCE_HTTPS_REDIRECT=1

# ── Service names (must match container_name in docker-compose.yml) ───────────
SCRAPER_SERVICE_NAME=api-scraper
VERIFIER_SERVICE_NAME=api-verifier

# ── Bot run modes ─────────────────────────────────────────────────────────────
SCRAPER_CONTINUOUS_MODE=true
VERIFIER_CONTINUOUS_MODE=true

# ── Google Analytics (optional) ───────────────────────────────────────────────
# Leave blank to disable GA entirely (no tracking script injected).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
