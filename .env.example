# Insecured API Keys - Linux deployment configuration
# Copy to `.env` and adjust before running:  cp .env.example .env

# --- PostgreSQL (docker compose service "db") ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# --- Web API ---
# Direct API port on the host (the API itself always listens on 8080 in-container).
# The UI (nginx) proxies to the API container directly, so this port is only
# needed for external API clients / debugging.
API_PORT=8081
# --- UI (nginx serving the statically exported site + API proxy on one origin) ---
# Port-forward THIS one to your public URL.
UI_PORT=8080
# Production / Development
ASPNETCORE_ENVIRONMENT=Production
# Set to 1 only if you terminate TLS yourself and want plain HTTP redirected
#FORCE_HTTPS_REDIRECT=1
# Public domains that will port-forward to the site (comma separated), e.g.
#ALLOWED_REFERRERS=myapp.example.com

# --- Service status checks (must match the container_name values in docker-compose.yml) ---
SCRAPER_SERVICE_NAME=api-scraper
VERIFIER_SERVICE_NAME=api-verifier
